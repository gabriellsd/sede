# Copie para .env.local (dev) ou .env (servidor).
# Sem MYSQL_* o app continua usando data/store.json.

# --- MySQL (banco próprio, separado do GLPI) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sede
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=sede
MYSQL_POOL_SIZE=10

# Cookies seguros atrás de HTTPS (recomendado em produção)
# SEDE_SECURE_COOKIES=true
# NODE_ENV=production
